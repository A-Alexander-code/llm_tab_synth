{
  "experiment": {
    "datasets": [
      "T1D_child",
      "heart_framingham",
      "breast_cancer",
      "diabetic_retinopathy",
      "diabetes_prima_indian",
      "kidney_disease"
    ],
    "models": [
      "great",
      "tabula",
      "realtabformer",
      "ctgan",
      "tvae",
      "gaussian_copula",
      "copulagan",
      "tabpfgen",
      "forestdiffusion",
      "mostlyai"
    ],
    "seeds": [13, 23, 42, 69, 88],
    "imbalance_ratios": [0.5, 0.6, 0.7, 0.8, 0.9, 1.0],
    "n_samples_per_class": 700,
    "target_column": "class",
    "test_split": 0.2
  },
  "model_params": {
    "great": {
      "llm": "distilgpt2",
      "batch_size": 16,
      "epochs": 200,
      "fp16": false,
      "dataloader_num_workers": 4,
      "gradient_checkpointing": true,
      "cuda_device": "0"
    },
    "tabula": {
      "llm": "distilgpt2",
      "batch_size": 32,
      "epochs": 50,
      "cuda_device": "0",
      "max_length_sample": 200,
      "temperature": 0.7,
      "top_k": 100
    },
    "realtabformer": {
      "model_type": "tabular",
      "epochs": 200,
      "batch_size": 16,
      "gradient_accumulation_steps": 4,
      "early_stopping_patience": 5,
      "cuda_device": "0",
      "num_bootstrap": 100
    },
    "ctgan": {
      "epochs": 300,
      "batch_size": 500,
      "generator_dim": [256, 256],
      "discriminator_dim": [256, 256]
    },
    "tvae": {
      "epochs": 300,
      "batch_size": 500,
      "compress_dims": [128, 128],
      "decompress_dims": [128, 128],
      "embedding_dim": 128
    },
    "gaussian_copula": {
      "default_distribution": "norm"
    },
    "copulagan": {
      "epochs": 300,
      "batch_size": 500,
      "generator_dim": [256, 256],
      "discriminator_dim": [256, 256],
      "default_distribution": "norm"
    },
    "tabpfgen": {
      "n_sgld_steps": 500,
      "sgld_step_size": 0.01,
      "sgld_noise_scale": 0.01,
      "device": "cuda",
      "max_iterations": 200
    },
    "forestdiffusion": {
      "n_t": 50,
      "duplicate_K": 100,
      "n_jobs": -1
    },
    "mostlyai": {
      "max_training_time": 300,
      "max_epochs": 100,
      "cuda_device": "cuda"
    }
  }
}
